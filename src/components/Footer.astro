---
import { navItems } from "../lib/nav";
import ContactLinks from "./ContactLinks.astro";
---

<footer class="bg-brand-secondary text-text-light text-sm py-6 mt-12">
  <div class="container mx-auto text-center space-y-4">
    <nav aria-label="Footer">
      <ul class="flex justify-center space-x-6 text-lg">
        {
          navItems.map(({ name, href }) => (
            <li>
              <a
                href={href}
                class="hover:bg-brand-secondaryDark hover:text-white px-3 py-1 rounded transition"
              >
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <ContactLinks class="justify-center text-base" />

    <p>
      &copy; {new Date().getFullYear()} Silver Coast Fitness. All rights reserved.
    </p>
  </div>
</footer>
