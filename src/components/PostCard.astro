---
const { href, title, description, pubDate, tags = [] } = Astro.props;
import { formatDate } from "../lib/formatDate";
---

<article class="p-6 rounded-lg border hover:shadow-sm transition">
  <a href={href} class="text-xl font-semibold underline">{title}</a>
  <p class="mt-2 text-slate-700">{description}</p>
  <div class="mt-3 text-sm text-slate-500 flex items-center gap-3">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    {tags.length > 0 && <span>•</span>}
    <ul class="flex gap-2 flex-wrap">
      {
        tags.map((t) => (
          <li>
            <a
              class="underline"
              href={`/health-tips/tag/${encodeURIComponent(t)}/`}
            >
              #{t}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</article>
