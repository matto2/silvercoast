---
import { navItems, isCurrent } from "../lib/nav";
import { contact } from "../lib/contact";
---

<header
  class="md:flex items-center justify-between text-text-dark md:pt-4 pt-0 pb-8 md:pb-0"
>
  <a
    href="/"
    class="flex justify-center md:justify-start items-center space-x-4"
  >
    <img src="/scf-logo.svg" alt="" class="w-16 h-16 block" />
    <span class="text-2xl md:text-3xl font-bold text-brand-primary font-serif">
      Silver Coast Fitness
    </span>
  </a>
  <nav aria-label="Main">
    <ul
      class="flex items-center justify-center md:justify-end space-x-2 min-[360px]:space-x-3 sm:space-x-6 md:space-x-12 text-lg sm:text-xl md:px-0"
    >
      {
        navItems.map(({ name, href }) => {
          const current = isCurrent(Astro.url.pathname, href);
          return (
            <li>
              <a
                href={href}
                aria-current={current ? "page" : undefined}
                class:list={[
                  "inline-flex items-center min-h-11 px-1",
                  current ? "font-bold text-brand-secondary" : "text-text-dark hover:text-brand-secondary",
                ]}
              >
                {name}
              </a>
            </li>
          );
        })
      }
      <li>
        <a
          href={contact.phoneHref}
          class="inline-flex items-center min-h-10 sm:min-h-11 px-3 sm:px-4 rounded-full whitespace-nowrap text-base sm:text-lg font-bold bg-brand-secondary text-text-light hover:bg-brand-secondaryDark"
        >
          Call Now
        </a>
      </li>
    </ul>
  </nav>
</header>
