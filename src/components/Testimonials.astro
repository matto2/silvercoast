---
import { testimonials } from "../data/testimonials";
---

{
  testimonials.length > 0 && (
    <section class="max-w-5xl mx-auto px-6 mt-12 mb-8">
      <h2 class="text-center text-3xl md:text-4xl font-bold text-brand-primary mb-8">
        What people are saying
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {testimonials.map(({ quote, name, descriptor }) => (
          <figure class="bg-stone-100 rounded-3xl p-6 md:p-8">
            <blockquote class="text-lg md:text-xl leading-relaxed text-text-dark">
              <p>“{quote}”</p>
            </blockquote>
            <figcaption class="mt-4 text-text-medium">
              <span class="font-semibold text-text-dark">{name}</span>
              {descriptor && <span>, {descriptor}</span>}
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
  )
}
