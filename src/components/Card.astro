---
import { Image } from "astro:assets";
const { img, alt, title, text } = Astro.props;
---

<div class="flex flex-col items-start mb-4">
  <Image
    src={img}
    alt={alt}
    widths={[400, 800, 1200]}
    sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw"
    class="w-full h-96 object-cover rounded-3xl"
  />
  <h3 class="text-xl font-bold mt-4 text-text-dark">{title}</h3>
  <p class="text-text-medium mt-2">{text}</p>
</div>
