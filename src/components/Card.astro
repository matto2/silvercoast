---
import { Image } from "astro:assets";
const { img, alt, title, text, label } = Astro.props;
---

<div class="flex flex-col items-start mb-4">
  <Image
    src={img}
    alt={alt}
    widths={[400, 800, 1200]}
    sizes="(min-width: 1280px) 33vw, (min-width: 768px) 50vw, 100vw"
    class="w-full h-96 object-cover rounded-3xl"
  />
  {
    label && (
      <p class="mt-4 text-text-medium font-semibold uppercase tracking-wide">
        {label}
      </p>
    )
  }
  <h3 class:list={["text-xl font-bold text-text-dark", label ? "mt-1" : "mt-4"]}>
    {title}
  </h3>
  <p class="text-text-medium mt-2">{text}</p>
</div>
