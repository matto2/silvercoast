---
import Layout from "../layouts/Layout.astro";
import photo1 from "../assets/photo1.jpg";
import { Image } from "astro:assets";
import Nav from "../components/Nav.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import BigContactCard from "../components/BigContactCard.astro";
import Hero from "../components/Hero.astro";
import ReviewCard from "../components/ReviewCard.astro";
import pain from "../assets/pain.jpg";
import personal from "../assets/personal.jpg";
import group from "../assets/group.jpg";
---

<Layout>
  <Nav currentPage="home" />

  <Hero
    headline="Move Well. Feel Strong."
    subhead="Personalized Fitness for Older Adults in Santa Cruz County"
    `
    text={`At Silver Coast Fitness, we help older adults in Santa Cruz County
    stay steady on their feet, lower their risk of falling, and keep their
    independence. Our personalized programs build the balance, strength, and
    confidence you need to move safely through everyday life, whether that's
    climbing stairs, walking the dog, or strolling along the coast. Take the
    first step toward feeling steadier today!`}
    `
    photo1={photo1}
    buttontext="Book a Free Balance Consultation"
    buttonlink="/contact"
  />

  <h2
    class="text-center text-4xl md:text-5xl font-bold mt-16 text-brand-primary"
  >
    Our Services
  </h2>

  <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 p-6">
    <!-- Block 1 -->
    <Card
      img={group}
      alt="stuff here"
      title="Small Group Balance Classes"
      text="Practice balance, coordination, and strength in a small, supportive group. Each class builds the steadiness and confidence that help prevent falls, and it's a fun, social way to stay motivated."
    />
    <!-- Block 2 -->
    <Card
      img={personal}
      alt="stuff here"
      title="Personalized Fall Prevention"
      text="One-on-one programs designed around your balance, strength, and goals. Sessions take place in your home or outdoors, so you practice staying steady in the places where it matters most."
    />
    <!-- Block 3 -->
    <Card
      img={pain}
      alt="stuff here"
      title="Pain Management"
      text="Pain can make you move less and feel less steady. Our targeted exercises help ease chronic pain so you can move freely, stay active, and keep your balance, always at a pace that feels comfortable for you."
    />
  </section>

  <!-- <h2
    class="text-center text-4xl md:text-5xl font-bold mt-4 text-brand-primary"
  >
    Customer Reviews
  </h2>
  <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 p-6">
    <ReviewCard
      reviewhead="Feeling way better!"
      text="Silver Coast Fitness has transformed my fitness journey. The personalized programs are exactly what I needed to stay active and independent."
      name="John D."
    />
    <ReviewCard
      reviewhead="Incredible support!"
      text="Tamra's expertise and dedication have made a huge difference in my recovery. I'm stronger and more confident than ever."
      name="Sarah M."
    />
    <ReviewCard
      reviewhead="Life-changing experience!"
      text="The small group classes are fun and motivating. I've met great people and improved my overall health significantly."
      name="Michael R."
    />
  </section> -->

  <BigContactCard
    title="Feel Steadier on Your Feet"
    text="Book a Free Balance Consultation"
  />
</Layout>
