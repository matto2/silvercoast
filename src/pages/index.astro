---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import Button from "../components/Button.astro";
import BigContactCard from "../components/BigContactCard.astro";
import Hero from "../components/Hero.astro";
import Testimonials from "../components/Testimonials.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { contact } from "../lib/contact";

// Home page photos: replace these files with real session photos using the
// same file names, or point an import at a new file.
import heroPhoto from "../assets/home/hero.jpg";
import movementPhoto from "../assets/home/balance.jpg";
import walkingPhoto from "../assets/home/walker.jpg";
import strengthPhoto from "../assets/home/class-strength.jpg";
import tamraPhoto from "../assets/tamra.jpg";

const towns = ["Santa Cruz", "Capitola", "Aptos", "Soquel", "Scotts Valley"];
const townList = new Intl.ListFormat("en", { type: "conjunction" }).format(towns);

const sessionDetails = [
  { term: "Where", detail: "In your home, or outdoors on walking routes near you." },
  { term: "Service area", detail: `${townList}.` },
  { term: "Session length", detail: "30, 45, or 60 minutes." },
  {
    term: "Pricing",
    detail:
      "Starting at $45 per session with a package of ten 30-minute sessions. Call to discuss other session lengths and packages.",
  },
  { term: "Cancellation", detail: "Cancel with at least 24 hours’ notice for a full refund." },
  {
    term: "Who it’s for",
    detail:
      "Older adults who want to stay active. We’ll talk about your goals and whether sessions are a good fit during a first phone call.",
  },
];

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Silver Coast Fitness",
  url: Astro.site?.href,
  telephone: contact.phoneHref.replace("tel:", ""),
  email: contact.email,
  areaServed: [
    ...towns.map((name) => ({ "@type": "City", name: `${name}, California` })),
    { "@type": "AdministrativeArea", name: "Santa Cruz County, California" },
  ],
};
---

<Layout>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(localBusiness)}
  />

  <Hero
    headline="Gentle fitness for older adults"
    text="Strength, balance, and walking encouragement, one-on-one."
    subtext={`Build a regular movement routine with friendly, one-on-one support. Silver Coast Fitness helps older adults in ${townList} stay active and independent through gentle strength exercises, balance practice, and walking, without an intimidating gym atmosphere.`}
    photo={heroPhoto}
    alt="Older woman doing a standing side stretch on a beach, guided by an instructor"
    buttontext="Get Started"
    buttonlink="/contact"
    secondarytext="Sessions & pricing"
    secondarylink="#pricing"
  />

  <h2
    id="services"
    class="text-center text-4xl md:text-5xl font-bold mt-16 text-brand-primary scroll-mt-8"
  >
    Services
  </h2>
  <p class="text-center text-lg md:text-xl leading-relaxed text-text-medium max-w-prose mx-auto mt-4 px-6">
    Fitness sessions built around your goals, your pace, and the activities you
    enjoy.
  </p>

  <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 p-6">
    <!-- Block 1 -->
    <Card
      img={movementPhoto}
      alt="Smiling older woman with arms extended, rising from a wooden bench on a coastal bluff above the ocean"
      title="Private Fitness Sessions"
      text="One-on-one sessions built around your goals and comfort level, with gentle strength and balance exercises at a manageable pace."
    />
    <!-- Block 2 -->
    <Card
      img={walkingPhoto}
      alt="Smiling older woman walking with a rolling walker along a coastal path, with an instructor at her side"
      title="Walking & Motivation"
      text="Make regular movement part of your routine with friendly encouragement and walking at a comfortable pace. We help you set manageable goals and stay motivated, one step at a time."
    />
    <!-- Block 3 -->
    <Card
      img={strengthPhoto}
      alt="Smiling older man in a blue t-shirt lifting a pair of light hand weights"
      label="Coming soon"
      title="Small-Group Fitness"
      text="Small-group sessions are in the works. Ask to be notified."
    />
  </section>

  <p class="text-lg leading-relaxed text-text-dark max-w-prose mx-auto px-6">
    Silver Coast Fitness provides general fitness instruction and exercise encouragement. We do not provide physical therapy, medical diagnosis, injury rehabilitation, or treatment for medical conditions.
  </p>

  <div class="text-center px-6">
    <Button text="Get in Touch" link="/contact" />
  </div>

  <section class="max-w-3xl mx-auto px-6 mt-12 mb-8">
    <h2
      class="text-center text-3xl md:text-4xl font-bold text-brand-primary mb-6"
    >
      A little encouragement to keep moving
    </h2>
    <p class="text-lg md:text-xl leading-relaxed text-text-medium max-w-prose mx-auto mb-4">
      Sometimes a change in routine makes it harder to stay active. Perhaps
      you’ve been spending more time sitting, or you’d simply enjoy some company
      and encouragement.
    </p>
    <p class="text-lg md:text-xl leading-relaxed text-text-medium max-w-prose mx-auto">
      One-on-one sessions offer a welcoming way to add activity to your week,
      with simple exercises and general guidance focused on everyday movement.
    </p>
  </section>

  <section
    id="pricing"
    class="bg-stone-100 rounded-3xl max-w-4xl mx-auto p-6 md:p-12 mt-12 mb-12 scroll-mt-8"
  >
    <h2
      class="text-center text-3xl md:text-4xl font-bold text-brand-primary mb-8"
    >
      Sessions &amp; pricing
    </h2>
    <dl class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6">
      {
        sessionDetails.map(({ term, detail }) => (
          <div>
            <dt class="font-bold text-text-dark">{term}</dt>
            <dd class="mt-1 text-text-medium">{detail}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section
    id="about-tamra"
    class="max-w-4xl mx-auto px-6 mt-12 mb-12 flex flex-col md:flex-row items-center gap-8"
  >
    <Image
      src={tamraPhoto}
      alt="Tamra Ancona"
      width={480}
      class="w-48 h-48 md:w-56 md:h-56 rounded-full shrink-0"
    />
    <div class="text-center md:text-left">
      <p class="text-text-medium font-semibold uppercase tracking-wide text-lg">
        About Tamra
      </p>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-primary mt-1 mb-4">
        Tamra Ancona
      </h2>
      <p class="text-lg md:text-xl leading-relaxed text-text-medium max-w-prose">
        Tamra Ancona brings 30 years of experience as a licensed Physical
        Therapist Assistant, including 25 years in home health, to her work with
        older adults. At Silver Coast Fitness, she offers friendly, one-on-one
        fitness sessions focused on strength, balance, and walking.
      </p>
      <a
        href="/about"
        class="inline-flex items-center min-h-11 mt-2 font-semibold text-brand-secondary underline underline-offset-4 hover:text-brand-secondaryDark"
      >
        More about Tamra
      </a>
    </div>
  </section>

  <Testimonials />

  <BigContactCard
    title="Looking for an activity your parent will enjoy?"
    text="Ask for a Parent"
  >
    <div class="max-w-prose px-2 md:px-0 mt-6">
      <p class="text-lg md:text-xl leading-relaxed text-text-medium mb-4">
        You may be looking for a friendly, personal way to help your parent move
        more and build a regular routine.
      </p>
      <p class="text-lg md:text-xl leading-relaxed text-text-medium">
        Silver Coast Fitness welcomes inquiries from family members, while
        keeping each participant’s interests and preferences at the center.
      </p>
    </div>
  </BigContactCard>

  <InquiryForm />
</Layout>
