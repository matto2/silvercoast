---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import BigContactCard from "../components/BigContactCard.astro";
import Hero from "../components/Hero.astro";
import Testimonials from "../components/Testimonials.astro";
import { contact } from "../lib/contact";

// Home page photos: replace these files with real class photos using the
// same file names, or point an import at a new file.
import heroPhoto from "../assets/home/hero.jpg";
import movementPhoto from "../assets/home/class-movement.jpg";
import walkingPhoto from "../assets/home/class-walking.jpg";
import strengthPhoto from "../assets/home/class-strength.jpg";
import tamraPhoto from "../assets/tamra.png";

const towns = ["Santa Cruz", "Capitola", "Aptos", "Soquel", "Scotts Valley"];

const localBusiness = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Silver Coast Fitness",
  url: Astro.site?.href,
  telephone: contact.phoneHref.replace("tel:", ""),
  email: contact.email,
  areaServed: [
    ...towns.map((name) => ({ "@type": "City", name: `${name}, California` })),
    { "@type": "AdministrativeArea", name: "Santa Cruz County, California" },
  ],
};
---

<Layout>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(localBusiness)}
  />

  <Hero
    headline="Move Well. Feel Strong."
    text="Friendly movement classes for older adults in Santa Cruz, Capitola, Aptos, Soquel, and Scotts Valley, with a focus on walking, gentle strength and balance exercises, and building an active routine."
    subtext="Whether you’re joining for yourself or helping a parent find a class, Silver Coast Fitness offers encouragement to keep moving at a comfortable pace."
    photo={heroPhoto}
    alt="Older woman doing a standing side stretch on a beach, guided by an instructor"
    buttontext="Explore Our Classes"
    buttonlink="#classes"
  />

  <h2
    id="classes"
    class="text-center text-4xl md:text-5xl font-bold mt-16 text-brand-primary scroll-mt-8"
  >
    Our Classes
  </h2>

  <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 p-6">
    <!-- Block 1 -->
    <Card
      img={movementPhoto}
      alt="Older man and a woman stretching their arms overhead together during an indoor exercise class"
      title="Movement Classes"
      text="Friendly classes built around simple, everyday movement. Come for the exercise, enjoy the company, and move at a pace that feels comfortable to you."
    />
    <!-- Block 2 -->
    <Card
      img={walkingPhoto}
      alt="Smiling older couple standing in a garden, each holding a rolled-up exercise mat"
      title="Walking & Everyday Activity"
      text="Walking is one of the simplest ways to stay active. Get encouragement and general guidance on making walking and everyday movement a regular part of your week, in a way that fits your interests."
    />
    <!-- Block 3 -->
    <Card
      img={strengthPhoto}
      alt="Smiling older man in a blue t-shirt lifting a pair of light hand weights"
      title="Strength & Balance"
      text="Gentle strength and balance exercises that relate to the things you do every day, like getting up from a chair or carrying groceries. Exercises can be adjusted to suit you."
    />
  </section>

  <section class="max-w-3xl mx-auto px-6 mt-12 mb-8">
    <h2
      class="text-center text-3xl md:text-4xl font-bold text-brand-primary mb-6"
    >
      A little encouragement to keep moving
    </h2>
    <p class="text-lg md:text-xl leading-relaxed text-text-medium max-w-prose mx-auto mb-4">
      Sometimes a change in routine makes it harder to stay active. Perhaps
      home health visits have ended, you’ve been spending more time sitting, or
      you’d simply enjoy some company and encouragement.
    </p>
    <p class="text-lg md:text-xl leading-relaxed text-text-medium max-w-prose mx-auto">
      Our movement classes offer a welcoming way to add activity to your week,
      with simple exercises and general guidance focused on everyday movement.
    </p>
  </section>

  <section
    class="max-w-4xl mx-auto px-6 mt-12 mb-12 flex flex-col md:flex-row items-center gap-8"
  >
    <Image
      src={tamraPhoto}
      alt="Tamra Ancona"
      width={480}
      class="w-48 h-48 md:w-56 md:h-56 rounded-full shrink-0"
    />
    <div class="text-center md:text-left">
      <p class="text-text-medium font-semibold uppercase tracking-wide text-lg">
        Meet your instructor
      </p>
      <h2 class="text-3xl md:text-4xl font-bold text-brand-primary mt-1 mb-4">
        Led by Tamra Ancona, PTA
      </h2>
      <p class="text-lg md:text-xl leading-relaxed text-text-medium max-w-prose">
        Tamra is a Physical Therapist Assistant with over 30 years of
        experience, including 15 years in home health care. In 2023, she
        founded Silver Coast Fitness to offer friendly movement classes for
        older adults.
      </p>
      <a
        href="/about"
        class="inline-flex items-center min-h-11 mt-2 font-semibold text-brand-secondary underline underline-offset-4 hover:text-brand-secondaryDark"
      >
        More about Tamra
      </a>
    </div>
  </section>

  <Testimonials />

  <BigContactCard
    title="Looking for an activity your parent will enjoy?"
    text="Ask About Our Classes"
  >
    <div class="max-w-prose px-2 md:px-0 mt-6">
      <p class="text-lg md:text-xl leading-relaxed text-text-medium mb-4">
        You may be looking for a friendly class that encourages your parent to
        move more, enjoy company, and build a regular routine.
      </p>
      <p class="text-lg md:text-xl leading-relaxed text-text-medium">
        Silver Coast Fitness welcomes inquiries from family members, while
        keeping each participant’s interests and preferences at the center.
      </p>
    </div>
  </BigContactCard>

  <p class="max-w-prose mx-auto px-6 mt-4 text-center text-lg text-text-dark">
    Silver Coast Fitness provides movement classes and general fitness
    guidance—not physical therapy, rehabilitation, or medical care.
  </p>
</Layout>
