---
import Layout from "../layouts/Layout.astro";
import biopic from "../assets/tamra.png";
import { Icon } from "astro-icon/components";
---

<Layout title="About | Silver Coast Fitness">
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mx-auto">
      <div class="grid place-content-center">
        <img
          src={biopic.src}
          alt="Tamra Ancona"
          class="w-60 h-60 md:w-80 md:h-80 rounded-full mx-auto md:mt-20"
        />
      </div>
      <div class="grid place-content-center">
        <h1 class="text-2xl font-bold mt-2 mb-4 md:mt-16 text-text-dark">
          Tamra Ancona, PTA
        </h1>
        <p class="md:text-lg text-left text-text-medium mb-4">
          I’m a Physical Therapist Assistant with over 30 years of experience,
          including 15 years working in home health care.
        </p>
        <p class="md:text-lg text-left text-text-medium mb-4">
          In 2023, I founded Silver Coast Fitness to offer friendly movement
          classes for older adults, with a focus on walking, gentle strength
          and balance exercises, and building an active routine. I am
          certified in Basic Life Support (BLS) and Cardiopulmonary
          Resuscitation (CPR).
        </p>
        <p class="md:text-lg text-left text-text-dark">
          Silver Coast Fitness provides movement classes and general fitness
          guidance—not physical therapy, rehabilitation, or medical care.
        </p>
        <a
          href="https://www.linkedin.com/in/tamra-ancona-06456065"
          aria-label="Tamra Ancona on LinkedIn"
        >
          <Icon name="linkedin" class="w-8 h-8 mt-4 text-sky-600" />
        </a>
      </div>
    </div>
  </div>
</Layout>
