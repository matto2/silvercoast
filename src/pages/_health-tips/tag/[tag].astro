---
import Layout from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import PostCard from "../../../components/PostCard.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  const tags = Array.from(new Set(posts.flatMap((p) => p.data.tags)));
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft && p.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title={`Health Tips – #${tag}`}>
  <section class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-semibold">#{tag}</h1>
    <div class="mt-8 grid gap-6">
      {
        posts.map(({ id, data }) => (
          <PostCard
            href={`/health-tips/${id}/`}
            title={data.title}
            description={data.description}
            pubDate={data.pubDate}
            tags={data.tags}
          />
        ))
      }
    </div>
  </section>
</Layout>
