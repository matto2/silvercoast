---
import Layout from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import PostCard from "../../../components/PostCard.astro";

export async function getStaticPaths() {
  const all = (await getCollection("blog"))
    .filter((p) => !p.data.draft)
    .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  const PAGE_SIZE = 8;
  const total = Math.ceil(all.length / PAGE_SIZE);

  return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
    params: { page: String(i + 2) }, // /page/2 …
    props: { all, page: i + 2, PAGE_SIZE },
  }));
}

const { all, page, PAGE_SIZE } = Astro.props;
const start = (page - 1) * PAGE_SIZE;
const posts = all.slice(start, start + PAGE_SIZE);
const totalPages = Math.ceil(all.length / PAGE_SIZE);
---

<Layout title={`Health Tips – Page ${page}`}>
  <section class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-semibold">Health Tips</h1>
    <div class="mt-8 grid gap-6">
      {
        posts.map(({ id, data }) => (
          <PostCard
            href={`/health-tips/${id}/`}
            title={data.title}
            description={data.description}
            pubDate={data.pubDate}
            tags={data.tags}
          />
        ))
      }
    </div>

    <nav class="mt-10 flex items-center justify-between">
      {
        page > 2 ? (
          <a class="underline" href={`/health-tips/page/${page - 1}/`}>
            ← Prev
          </a>
        ) : (
          <a class="underline" href="/health-tips/">
            ← First
          </a>
        )
      }
      {
        page < totalPages ? (
          <a class="underline" href={`/health-tips/page/${page + 1}/`}>
            Next →
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </section>
</Layout>
