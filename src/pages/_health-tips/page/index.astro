---
import Layout from "../../../layouts/Base.astro";
import { getCollection } from "astro:content";
import PostCard from "../../../components/PostCard.astro";

const all = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const PAGE_SIZE = 8;
const pagePosts = all.slice(0, PAGE_SIZE);
const totalPages = Math.ceil(all.length / PAGE_SIZE);
---

<Layout title="Health Tips">
  <section class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="text-3xl font-semibold">Health Tips</h1>
    <div class="mt-8 grid gap-6">
      {
        pagePosts.map(({ id, data }) => (
          <PostCard
            href={`/health-tips/${id}/`}
            title={data.title}
            description={data.description}
            pubDate={data.pubDate}
            tags={data.tags}
          />
        ))
      }
    </div>

    {
      totalPages > 1 && (
        <nav class="mt-10 flex items-center justify-between">
          <span />
          <a class="underline" href="/health-tips/page/2/">
            Next →
          </a>
        </nav>
      )
    }
  </section>
</Layout>
